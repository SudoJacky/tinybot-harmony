{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "compressNativeLibs": true,
    "pages": "$profile:main_pages",
    "metadata": [
      { "name": "appgallery_privacy_hosted", "value": "1" },
      { "name": "appgallery_privacy_link_privacy_statement", "value": "https://agreement-drcn.hispace.dbankcloud.cn/index.html?lang=zh&agreementId=2067046195590618816" },
      { "name": "client_id", "value": "6917617825245755680" },
      { "name": "ohos.fileshare.supportPreservePersistentPermission" }
    ],
    "requestPermissions": [
      { "name": "ohos.permission.INTERNET" },
      { "name": "ohos.permission.KEEP_BACKGROUND_RUNNING" },
      { "name": "ohos.permission.FILE_ACCESS_PERSIST" },
      {
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:microphone_reason",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "backgroundModes": ["dataTransfer"],
        "description": "$string:EntryAbility_desc",
        "icon": "$media:tinybot_layered_icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startup_wordmark",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "metadata": [
          { "name": "ohos.ability.shortcuts", "resource": "$profile:shortcuts_config" }
        ],
        "skills": [
          { "actions": ["ohos.want.action.viewData"], "entities": ["entity.system.browsable"], "uris": [{ "scheme": "tinybot-harmony", "host": "oauth", "path": "/callback" }] },
          { "actions": ["ohos.want.action.sendData"], "uris": [
            { "scheme": "file", "utd": "general.text", "maxFileSupported": 4 },
            { "scheme": "file", "utd": "general.hyperlink", "maxFileSupported": 4 },
            { "scheme": "file", "utd": "general.image", "maxFileSupported": 4 },
            { "scheme": "file", "utd": "com.adobe.pdf", "maxFileSupported": 4 },
            { "scheme": "file", "utd": "org.openxmlformats.wordprocessingml.document", "maxFileSupported": 4 },
            { "scheme": "file", "utd": "org.openxmlformats.spreadsheetml.sheet", "maxFileSupported": 4 },
            { "scheme": "file", "utd": "org.openxmlformats.presentationml.presentation", "maxFileSupported": 4 }
          ] },
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "TinybotFormAbility",
        "srcEntry": "./ets/entryformability/TinybotFormAbility.ets",
        "label": "$string:widget_name",
        "description": "$string:widget_description",
        "type": "form",
        "exported": true,
        "metadata": [
          { "name": "ohos.extension.form", "resource": "$profile:form_config" }
        ]
      },
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ],
      }
    ]
  }
}
