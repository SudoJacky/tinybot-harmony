#!/bin/busybox sh
set -eu
if [ ! -c /dev/null ]; then /bin/busybox mount -t devtmpfs devtmpfs /dev; fi
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t tmpfs -o size=24m,nosuid,nodev,uid=65533,gid=65533,mode=700 tmpfs /work
/bin/busybox mount -t tmpfs -o size=24m,nosuid,nodev,mode=755 tmpfs /run
/bin/busybox mkdir -p /run/tinybot /dev/pts
/bin/busybox mount -t devpts -o mode=620,ptmxmode=666 devpts /dev/pts
/bin/busybox chmod 600 /dev/ttyAMA0 /dev/vdb /dev/vdc
exec /usr/bin/python3 -I -S -B /linux-console.pyc
